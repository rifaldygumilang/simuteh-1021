        "import cv2",
        "import numpy as np",
        "",
        "def proses_deteksi_tepi(gray_img):",
        "    # Menggunakan Canny Edge Detection",
        "    tepi = cv2.Canny(gray_img, 100, 200)",
        "    return tepi",
        "",
        "print(\"Modul P5 Deteksi Tepi siap.\")"
      ]
